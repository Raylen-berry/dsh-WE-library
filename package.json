{
  "name": "dsh-we-library",
  "version": "0.1.0",
  "description": "DSH 的 Wallpaper Engine 库桥：发现本机壁纸库，提供媒体与场景静态图，支持原生实时桥接入。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "wallpaper-engine",
    "we-library",
    "scene"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node tools/run-all.mjs",
    "native:build": "node tools/build-native.mjs",
    "native:install": "node tools/install-native-bridge.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "we",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-alpha.1 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raylen-berry/dsh-WE-library.git"
  },
  "bugs": {
    "url": "https://github.com/Raylen-berry/dsh-WE-library/issues"
  },
  "homepage": "https://github.com/Raylen-berry/dsh-WE-library#readme",
  "license": "MIT"
}
